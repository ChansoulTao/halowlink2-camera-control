#!/bin/sh

ip="${1:-}"
expected_mac=$(printf '%s' "${2:-}" | tr 'a-f' 'A-F')
mode="${3:-}"
value="${4:-}"

valid_ip() {
	case "$1" in ''|*[!0-9.]*) return 1 ;; esac
	[ "$(printf '%s\n' "$1" | awk -F. '
		NF == 4 {
			for (i = 1; i <= 4; i++)
				if ($i !~ /^[0-9]+$/ || $i > 255)
					exit
			print "valid"
		}')" = valid ]
}

case "$mode" in
	on|off) [ "$#" -eq 3 ] || exit 2 ;;
	brightness)
		case "$value" in ''|*[!0-9]*|????*) exit 2 ;; esac
		[ "$value" -le 100 ] && [ "$#" -eq 4 ] || exit 2
		;;
	*) exit 2 ;;
esac
printf '%s\n' "$expected_mac" | grep -qE '^([0-9A-F]{2}:){5}[0-9A-F]{2}$' || exit 2

lease_file=$(uci -q get 'dhcp.@dnsmasq[0].leasefile')
[ -n "$lease_file" ] || lease_file=/tmp/dhcp.leases
if [ -r "$lease_file" ]; then
	lease_ip=$(awk -v wanted="$(printf '%s' "$expected_mac" | tr 'A-F' 'a-f')" -v now="$(date +%s)" '
		NF >= 3 && tolower($2) == wanted && ($1 == 0 || $1 > now) { address = $3 }
		END { if (address != "") print address }
	' "$lease_file")
	valid_ip "$lease_ip" && ip="$lease_ip"
fi
valid_ip "$ip" || exit 2

command="exec /usr/sbin/camera-network-leds '$mode'"
[ "$mode" != brightness ] || command="$command '$value'"
ssh -y -I 6 -i /etc/dropbear/camera-network-client-key "root@$ip" \
	"actual=\$(cat /sys/class/net/wlan0/address 2>/dev/null | tr 'a-f' 'A-F'); [ \"\$actual\" = '$expected_mac' ] || { echo 'Client identity mismatch' >&2; exit 3; }; $command" || exit $?

# Only cache settings acknowledged by the correct Client, and keep them
# across AP reboots as well as Client reboots.
section="cam_$(printf '%s' "$expected_mac" | tr -d ':' | tr 'A-F' 'a-f')"
uci -q get "camera_network.$section" >/dev/null || uci -q set "camera_network.$section=camera" || exit 1
uci -q set "camera_network.$section.last_ip=$ip" || exit 1
if [ "$mode" = brightness ]; then
	uci -q set "camera_network.$section.remote_leds_brightness=$value" || exit 1
else
	enabled=1; [ "$mode" != off ] || enabled=0
	uci -q set "camera_network.$section.remote_leds_enabled=$enabled" || exit 1
fi
uci -q commit camera_network
