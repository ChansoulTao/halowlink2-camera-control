work/ipk-control/
work/ipk-debian-binary

# Local release archives
outputs/*.tar.gz
outputs/luci-app-camera-network_1.0.0-1_all.ipk
outputs/luci-app-camera-network_1.0.1-1_all.ipk
outputs/luci-app-camera-network_*_all.ipk

# Cache-busting deployment snapshots; index.js is the maintained source
work/camera-network/root/www/luci-static/resources/view/camera-network/index-v*.js

# macOS metadata and AppleDouble sidecars
._*
